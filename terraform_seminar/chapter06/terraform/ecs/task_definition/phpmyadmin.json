[
  {
    "name": "phpmyadmin",
    "image": "public.ecr.aws/docker/library/phpmyadmin:5.2.1",
    "cpu": 256,
    "memory": 512,
    "essential": true,
    "portMappings": [
      {
        "containerPort": 80,
        "protocol": "tcp"
      }
    ],
    "environment": [
      { "name": "PMA_HOST", "value": "${db_host}" },
      { "name": "PMA_USER", "value": "${db_user}" },
      { "name": "PMA_PASSWORD", "value": "${db_pass}" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "${log_group_name}",
        "awslogs-region": "${aws_region}",
        "awslogs-stream-prefix": "phpmyadmin"
      }
    }
  }
]