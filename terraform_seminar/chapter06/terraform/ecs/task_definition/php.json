[
  {
    "name": "php",
    "image": "${ecr_image_uri}",
    "cpu": 256,
    "memory": 512,
    "essential": true,
    "portMappings": [
      {
        "containerPort": 80,
        "protocol": "tcp"
      }
    ],
    "environment": [
      { "name": "DB_HOST", "value": "${db_host}" },
      { "name": "DB_USER", "value": "${db_user}" },
      { "name": "DB_PASS", "value": "${db_pass}" },
      { "name": "DB_NAME", "value": "${db_name}" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "${log_group_name}",
        "awslogs-region": "${aws_region}",
        "awslogs-stream-prefix": "php"
      }
    }
  }
]